{
    ":configurator:resource-version": 1,
    ":configurator:version": "1.0.0",
    "InitialModelLoaderRequiredModels": {
        "required.models": []
    },
    "EPackageStageActionService": {
        "trigger.stages": ["draft", "approved", "release"],
        "storageService.target": "(storage.type=file)"
    },
    "QvtStageActionService": {
        "trigger.stages": ["draft", "approved", "release"]
    },
    "org.apache.felix.hc.generalchecks.ServicesCheck~tenant": {
        // Must carry "atlas": the health servlet filters its default endpoint by that
        // tag, and the Felix default ("systemalive") alone would drop this check out of
        // /atlas/system/health - which would then report OK while the scope is missing.
        "hc.tags": ["atlas", "systemalive"],
        // Distinct from the Felix default ("Services Ready Check"), which every
        // ServicesCheck would otherwise share: two checks of the same name are
        // indistinguishable in the endpoint output, and a "?tags=" query collapses
        // them into one, so a scope that is down can be hidden by one that is up.
        "hc.name": "Scope Ready Check: civitas",
        "services.list": ["(scope.name=civitas)"]
    },
    "ScopeService~civitas": {
        "atlas.scope": "civitas",
        "scope.name": "civitas",
        "scope.description": "Civitas Scope",
        "scope.parent": "atlas",
        "registryService.target": "(|(registry.name=schema)(registry.name=default)(registry.name=transformations))",
        "registryService.cardinality.minimum:int": 1
    },
    "RegistryService~schema": {
        "registry.type": "SCHEMA",
        "registry.name": "schema",
        "registry.description": "The schema registry to store EPackage objects",
        "stageActionService.target": "(|(component.name=EPackageStageActionService)(component.name=SchemaDependencyStageAction))",
        "stageGate.target": "(component.name=SchemaDeleteGate)",
        "stageGate.cardinality.minimum:int": 1,
        "stage.storage.mappings": [
            "draft:file",
            "approved:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:approved",
            "approved:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "approved",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "root.eclass.uri": "http://www.eclipse.org/emf/2002/Ecore#//EPackage",
        "resourceSet.target": "(emf.name=ecore)"
    },
    "RegistryService~transformations": {
        "schemaPackage.target": "(emf.nsURI=http://www.eclipse.org/fennec/m2x/compiled/1.0)",
        "registry.type": "TRANSFORMATION",
        "registry.name": "transformations",
        "registry.description": "QVT-O transformation sources, compiled units and their diagnostics (issue #239)",
        "stageActionService.target": "(component.name=QvtStageActionService)",
        "stageActionService.cardinality.minimum:int": 1,
        "stageGate.target": "(component.name=QvtTransitionGate)",
        "stageGate.cardinality.minimum:int": 1,
        "stage.storage.mappings": [
            "draft:file",
            "approved:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:approved",
            "approved:release"
        ],
        "delete.after.transition": false,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "approved",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "root.eclass.uri": [
            "http://www.eclipse.org/fennec/m2x/compiled/1.0#//SourceUnit"
        ],
        "derived.eclass.uri": [
            "http://www.eclipse.org/fennec/m2x/compiled/1.0#//CompiledUnit"
        ],
        "resourceSet.target": "(emf.name=compiled)"
    },
    "RegistryService~default": {
        "registry.name": "default",
        "registry.description": "The person registry to store Person objects",
        "stage.storage.mappings": [
            "draft:file",
            "approved:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:approved",
            "approved:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "approved",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "root.eclass.uri": "http://www.eclipse.org/emf/2002/Ecore#//EObject",
        "resourceSet.target": "(emf.name=ecore)"
    }
}
