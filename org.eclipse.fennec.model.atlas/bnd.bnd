-library: enable-emf
-workingset: atlas

-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.eclipse.daanse.io.fs.watcher.api;version=latest,\
	org.osgi.util.tracker;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.gecko.emf.util.documentation.generators.apis;version=latest,\
	org.apache.felix.gogo.runtime;version=latest,\
	org.eclipse.fennec.codec;version=latest,\
	org.eclipse.fennec.codec.constants;version=latest,\
	org.eclipse.fennec.model.atlas.emf.common;version=snapshot,\
	org.eclipse.fennec.codec.constants;version=latest,\
	org.eclipse.fennec.codec;version=latest