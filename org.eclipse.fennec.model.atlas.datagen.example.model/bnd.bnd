# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-library: enableEMF

# Code generation is disabled to preserve manual operation implementations in
# CompanyImpl (getTotalEmployees, findEmployeesByNamePrefix). Re-enable temporarily
# when the ecore/genmodel changes, then disable again after regenerating.
-generate:\
	model/dge.genmodel;\
		generate=fennecEMF;\
		genmodel=model/dge.genmodel;\
		output=src\

# If this is not done with a instruction namespace, bnd would think you like
# to take full control over whats exported and imported and will ignore @Export
# Bundle Annotations		
-includeresource.model: model=model

Bundle-Version: 1.0.0.SNAPSHOT

-buildpath: \
	org.osgi.service.condition;version=latest

