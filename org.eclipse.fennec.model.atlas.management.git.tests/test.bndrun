	junit-platform-commons;version='[1.14.2,1.14.3)',\
	org.apache.aries.component-dsl.component-dsl;version='[1.2.2,1.2.3)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.apache.aries.typedevent.bus;version='[1.0.1,1.0.2)',\
	org.apache.commons.commons-codec;version='[1.22.0,1.22.1)',\
	org.apache.commons.commons-compress;version='[1.28.0,1.28.1)',\
	org.apache.commons.commons-io;version='[2.22.0,2.22.1)',\
	org.apache.commons.lang3;version='[3.20.0,3.20.1)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.scr;version='[2.2.14,2.2.15)',\
	org.apache.lucene.core;version='[9.12.3,9.12.4)',\
	org.apache.lucene.queries;version='[9.12.3,9.12.4)',\
	org.apache.lucene.queryparser;version='[9.12.3,9.12.4)',\
	org.apache.sshd.osgi;version='[2.17.1,2.17.2)',\
	org.apache.sshd.sftp;version='[2.17.1,2.17.2)',\
	org.eclipse.daanse.tooling.testcontainers.core;version='[0.0.1,0.0.2)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.emf.osgi.component;version='[0.1.2,0.1.3)',\
	org.eclipse.fennec.model.atlas.management;version=snapshot,\
	org.eclipse.fennec.model.atlas.management.git;version=snapshot,\
	org.eclipse.fennec.model.atlas.management.git.github.webhook.model;version=snapshot,\
	org.eclipse.fennec.model.atlas.management.git.tests;version=snapshot,\
	org.eclipse.fennec.model.atlas.management.git.webhook.model;version=snapshot,\
	org.eclipse.fennec.model.atlas.management.lucene;version=snapshot,\
	org.eclipse.fennec.model.atlas.scope.api;version=snapshot,\
	org.eclipse.fennec.model.atlas.tests.common;version=snapshot,\
	org.eclipse.fennec.model.atlas.workflow;version=snapshot,\
	org.eclipse.jgit;version='[7.7.0,7.7.1)',\
	org.eclipse.jgit.ssh.apache;version='[7.7.0,7.7.1)',\
	org.gecko.jgit;version='[1.0.0,1.0.1)',\
	org.objectweb.asm;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.commons;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.tree;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.tree.analysis;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.util;version='[9.9.1,9.9.2)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.service.cm;version='[1.6.1,1.6.2)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.service.typedevent;version='[1.0.0,1.0.1)',\
	org.osgi.test.common;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5.cm;version='[1.3.0,1.3.1)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	org.osgi.util.pushstream;version='[1.1.0,1.1.1)',\
	slf4j.api;version='[2.0.16,2.0.17)',\
	slf4j.simple;version='[2.0.16,2.0.17)',\
	tools.jackson.core.jackson-core;version='[3.1.0,3.1.1)',\
	tools.jackson.core.jackson-databind;version='[3.1.0,3.1.1)'

# The framework-extension spifly variant installs a weaving hook that breaks class loading in
# other bundles ("Weaving hook failed"): felix.http.jetty, the aries typedevent bus and daanse's
# PathWatcherService have all been taken out by it. Listing spifly.dynamic.bundle in -runbundles
# is not enough - testOSGi runs the RESOLVED bndrun and the resolver swaps the variant in.
-runblacklist: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'
