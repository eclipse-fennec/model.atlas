-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.git.tests',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.git',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.lucene',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.workflow',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.git.webhook.model',\
	bnd.identity;id='org.gecko.jgit',\
	bnd.identity;id='org.apache.aries.typedevent.bus',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component',\
	bnd.identity;id='org.eclipse.daanse.tooling.testcontainers.core',\
	bnd.identity;id='slf4j.simple'

-runbundles.test: \
	org.eclipse.fennec.model.atlas.management.git.tests;version=snapshot

-runfw: org.apache.felix.framework
-runee: JavaSE-21
-runbundles: \
	bcprov;version='[1.84.0,1.84.1)',\
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)',\
	com.googlecode.javaewah.JavaEWAH;version='[1.2.3,1.2.4)',\
