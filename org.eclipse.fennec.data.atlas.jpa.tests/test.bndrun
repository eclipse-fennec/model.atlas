-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.data.atlas.jpa.tests',\
	bnd.identity;id='org.eclipse.daanse.io.fs.watcher.watchservice',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.jpa.datasource',\
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.h2',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.jpa.watcher',\
	bnd.identity;id='org.eclipse.daanse.jdbc.db.dialect.db.h2'
	
-runbundles.test: \
	org.eclipse.fennec.data.atlas.jpa.tests;version=snapshot

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'

-runee: JavaSE-21

-runproperties: \
	data-folder=${.}/data/

-runbundles: \
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	org.apache.aries.spifly.dynamic.framework.extension;version='[1.3.7,1.3.8)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.scr;version='[2.2.14,2.2.15)',\
	org.eclipse.daanse.io.fs.watcher.api;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.io.fs.watcher.watchservice;version='[0.0.1,0.0.2)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.data.atlas.jpa.tests;version=snapshot,\
	org.eclipse.fennec.data.atlas.mapping.model;version=snapshot,\
	org.eclipse.fennec.emf.gecko.compatibility.api;version='[0.1.2,0.1.3)',\
	org.eclipse.fennec.emf.osgi.component.minimal;version='[0.1.2,0.1.3)',\
	org.eclipse.fennec.emf.osgi.model.info;version='[0.1.2,0.1.3)',\
	org.eclipse.fennec.persistence;version='[1.0.0,1.0.1)',\
	org.eclipse.fennec.persistence.orm;version='[1.0.0,1.0.1)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.service.cm;version='[1.6.1,1.6.2)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.test.common;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5.cm;version='[1.3.0,1.3.1)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	slf4j.api;version='[2.0.16,2.0.17)',\
	slf4j.simple;version='[2.0.16,2.0.17)',\
	com.h2database;version='[2.3.232,2.3.233)',\
	org.eclipse.daanse.jdbc.datasource.common;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.datasource.h2;version='[0.0.1,0.0.2)',\
	org.eclipse.fennec.data.atlas.jpa.datasource;version=snapshot,\
	org.eclipse.fennec.data.atlas.jpa.watcher;version=snapshot,\
	org.eclipse.daanse.jdbc.db.api;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.db.dialect.api;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.db.dialect.db.common;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.db.dialect.db.h2;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.db.record;version='[0.0.1,0.0.2)'