	tools.jackson.core.jackson-core;version='[3.1.0,3.1.1)',\
	tools.jackson.core.jackson-databind;version='[3.1.0,3.1.1)',\
	jakarta.persistence-api;version='[3.2.0,3.2.1)',\
	de.siegmar.fastcsv;version='[3.4.0,3.4.1)',\
	org.apache.felix.cm.json;version='[2.0.6,2.0.7)',\
