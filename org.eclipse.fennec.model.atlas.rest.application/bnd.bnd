-library: enableEMF

-buildpath: \
	jakarta.ws.rs-api;version=latest,\
	org.apache.felix.http.servlet-api;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.osgi.service.jakartars;version=latest,\
	org.osgi.service.http.whiteboard;version=latest,\
	io.swagger.core.v3.swagger-core.jakarta;version=latest,\
	io.swagger.core.v3.swagger-jaxrs2.jakarta;version=latest,\
	io.swagger.core.v3.swagger-annotations;version=latest,\
	io.swagger.core.v3.swagger-integration.jakarta;version=latest,\
	io.swagger.core.v3.swagger-models.jakarta;version=latest,\
	com.fasterxml.jackson.core.jackson-core;version=latest,\
	com.fasterxml.jackson.core.jackson-databind;version=latest,\
	org.eclipse.fennec.m2x.ocl.api;version=latest,\
	org.eclipse.fennec.m2x.ocl.model;version=latest,\
	org.eclipse.fennec.model.atlas.mediatypes.api;version=snapshot,\
	org.eclipse.fennec.model.atlas.runtime;version=snapshot,\
	org.eclipse.fennec.model.atlas.rest.model;version=snapshot,\
	org.eclipse.fennec.model.atlas.management;version=snapshot,\
	org.eclipse.fennec.model.atlas.workflow;version=snapshot,\
	org.eclipse.fennec.model.atlas.management.lucene;version=snapshot,\
	org.eclipse.fennec.model.atlas.rest.common;version=snapshot,\
	org.eclipse.fennec.codec.rest;version=latest,\
	org.eclipse.fennec.codec.api;version=latest,\
	org.eclipse.fennec.model.atlas.scope.api;version=snapshot
# Hard runtime requirement on the Model Atlas scoped-resource-set
# filter (provided by org.eclipse.fennec.model.atlas.rest.filter).
# Without this, the @Context ResourceSet injection would not see the
# scope/stage-aware ScopedResourceSetProvider and requests under
# /{scopeName}/stages/{stageName}/... would resolve against the
# default ResourceSet. The unique osgi.implementation identifier also
# ensures the resolver picks the production filter bundle, not the
# test bundle (which deliberately does not declare this capability).
Require-Capability: \
	osgi.implementation;\
		filter:="(&(osgi.implementation=org.eclipse.fennec.model.atlas.scoped-resource-set)(version>=1.0.0))"
