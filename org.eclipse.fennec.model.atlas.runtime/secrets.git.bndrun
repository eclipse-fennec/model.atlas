# Local-run secrets for the git backend. Edit these to point at YOUR repo + SSH key.
# These are passed as -D system properties and picked up by the git config's
# $[env:X;default=$[prop:X;default=...]] interpolation (env still wins if also set).
#
# IMPORTANT: org.gecko.jgit.GitServiceImpl is SSH-ONLY — GIT_REPO must be an
# scp-like SSH URL (git@host:owner/repo.git), NOT https:// or git://. The repo must
# have the branches configured as stages (draft, approved, release by default).
-runvm: \
	-DGIT_REPO=git@github.com:acme/models.git,\
	-DGIT_PRIVATE_KEY=${.}/runtime/secrets/git_deploy_key,\
	-DGIT_PRIVATE_KEY_PASSPHRASE=,\
	-DGIT_WEBHOOK_GITHUB_SECRET=,\
	-DGIT_WEBHOOK_GITLAB_TOKEN=,\
	-DSTORAGE_ROOT=/tmp/model-atlas/
