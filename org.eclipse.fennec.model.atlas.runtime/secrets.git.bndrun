# Local-run secrets for the git backend. Edit these to point at YOUR repo (+ SSH key
# for SSH remotes). These are passed as -D system properties and picked up by the git
# config's $[env:X;default=$[prop:X;default=...]] interpolation (env still wins if also set).
#
# GIT_REPO may be an scp-like SSH URL (git@host:owner/repo.git), ssh://, https:// or
# git://. Anonymous https///git:// remotes need no key; for SSH remotes the key may be
# ed25519/OpenSSH-format (gecko.jgit uses jgit's Apache MINA sshd backend). The repo
# must have the branches configured as stages (draft, approved, release by default).
-runvm: \
	-DGIT_REPO=https://github.com/your-org/your-model-repo.git,\
	-DGIT_PRIVATE_KEY=,\
	-DGIT_PRIVATE_KEY_PASSPHRASE=,\
	-DGIT_WEBHOOK_GITHUB_SECRET=,\
	-DGIT_WEBHOOK_GITLAB_TOKEN=,\
	-DGIT_WEBHOOK_REQUIRE_SIGNATURE=false,\
	-DSTORAGE_ROOT=/tmp/model-atlas/
