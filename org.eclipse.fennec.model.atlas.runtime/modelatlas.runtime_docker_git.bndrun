-include: modelatlas.runtime_docker.bndrun

# The git backend + jgit stack are NOT in the base runtime (unlike file/apicurio), so pull them
# in here and RESOLVE this bndrun to populate -runbundles with the full closure.
-runrequires.git: \
	bnd.identity;id='org.eclipse.fennec.model.atlas.runtime.config.docker.git',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.git',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.git.webhook.rest',\
	bnd.identity;id='org.gecko.jgit',\
	bnd.identity;id='org.eclipse.jgit.ssh.jsch'

# The config bundle is a plain resource bundle (no deps) so it can be merged directly; the rest
# come in via the resolve of the requirements above.
-runbundles.docker.git: org.eclipse.fennec.model.atlas.runtime.config.docker.git
-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)';startlevel=1000,\
	com.fasterxml.jackson.core.jackson-core;version='[2.19.2,2.19.3)';startlevel=1001,\
	com.fasterxml.jackson.core.jackson-databind;version='[2.19.2,2.19.3)';startlevel=1002,\
