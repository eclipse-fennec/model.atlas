-include: \
	modelatlas.runtime_docker.bndrun

-runbundles.local: org.eclipse.fennec.model.atlas.runtime.config.local

# The runtime service, for looking at a live Atlas from the shell. Local only — the
# deployed images are not touched.
#
# No start level, so these come up after everything else. That is harmless here and only
# here: the service tracks what is already registered when it opens, so a late start costs
# it nothing, unlike a bundle that has to be in place before the model loader runs.
-runbundles.runtimeinfo: \
	org.eclipse.fennec.model.atlas.runtime.info,\
	org.eclipse.fennec.services.runtime

# Metrics from the runtime service, local only. The chain is: the logging sender publishes an
# OpenTelemetry, core.commons turns that into the MeterProvider our component binds. Both the
# sender and our own component take ConfigurationPolicy.REQUIRE, so without the configuration in
# config.local nothing is published and no gauge is ever built — see configs/telemetry.json, which
# holds a PID for each of them.
#
# The logging sender rather than OTLP on purpose: looking at what comes out should not need a
# collector, and which sender a deployment runs is its own decision. Swap in
# core.sender.http when there is somewhere to send to.
-runbundles.telemetry: \
	org.eclipse.fennec.model.atlas.telemetry,\
	org.eclipse.osgi-technology.opentelemetry.repack,\
	org.eclipse.osgi-technology.opentelemetry.core.commons,\
	org.eclipse.osgi-technology.opentelemetry.core.sender.logging


-runproperties.local: \
    base.path=${.},\
    logback.configurationFile=file:${.}/runtime/etc/logback.xml,\
    gecko.log.dir=${.}/runtime/logs,\
    org.apache.felix.configadmin.plugin.interpolation.secretsdir=${.}/runtime/secrets,\
    data=${.}/runtime/data/
    

-runtrace: true
-resolve: never