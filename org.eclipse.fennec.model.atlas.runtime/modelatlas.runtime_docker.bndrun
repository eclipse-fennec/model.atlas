-include: modelatlas.runtime_base.bndrun

-runbundles.docker: org.eclipse.fennec.model.atlas.runtime.config.docker
-runproperties.docker: \
	base.path=/opt/modelatlas,\
	logback.configurationFile=file:/opt/modelatlas/runtime/etc/logback.xml,\
	gecko.log.dir=/opt/meter/runtime/logs,\
	org.apache.felix.configadmin.plugin.interpolation.secretsdir=/opt/modelatlas/runtime/secrets,\
	data=/opt/modelatlas/runtime/data