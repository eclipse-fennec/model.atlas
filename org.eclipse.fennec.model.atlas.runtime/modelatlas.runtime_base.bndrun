# Configure Gecko Exporter
-runprovidedcapabilities: ${native_capability}

-resolve.effective: active

-runpath.slf4j: ${slf4j.runpath}
-runsystempackages.slf4j: ${slf4j.systempackages}

slf4j.systempackages: \
	org.slf4j;version=2.0.11,\
	org.slf4j.helpers;version=2.0.11,\
	org.slf4j.spi;version=2.0.11

slf4j.runpath:  \
	ch.qos.logback.classic;version='[1.5.3,1.5.4)',\
	ch.qos.logback.core;version='[1.5.3,1.5.4)',\
	jul.to.slf4j;version='[2.0.11,2.0.12)',\
	slf4j.api;version='[2.0.11,2.0.12)'

-runrequires: \
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='org.apache.felix.gogo.command',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.felix.metatype)(version>=1.2.4))',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.runtime',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.application',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.runtime.config',\
	bnd.identity;id='org.eclipse.fennec.codec.csv',\
	osgi.identity;filter:='(&(osgi.identity=org.gecko.emf.bson)(version>=1.2.6))',\
	osgi.identity;filter:='(&(osgi.identity=org.gecko.emf.json)(version>=1.5.1))',\
	osgi.identity;filter:='(&(osgi.identity=org.gecko.emf.ods)(version>=1.1.1))',\
	osgi.identity;filter:='(&(osgi.identity=org.gecko.emf.r_lang)(version>=1.0.1))',\
	osgi.identity;filter:='(&(osgi.identity=org.gecko.emf.xlsx)(version>=1.1.1))',\
	osgi.identity;filter:='(&(osgi.identity=org.eclipse.fennec.codec.info.model)(version>=1.0.0))',\
	bnd.identity;id='org.gecko.emf.util.documentation.generators.html',\
	bnd.identity;id='org.gecko.emf.util.documentation.generators.html.component',\
	bnd.identity;id='org.gecko.emf.util.documentation.generators.markdown',\
	bnd.identity;id='org.gecko.emf.util.documentation.generators.markdown.component',\
	bnd.identity;id='org.gecko.emf.util.documentation.generators.mermaid',\
	bnd.identity;id='org.gecko.emf.util.documentation.generators.plantuml',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.xsdschema',\
	bnd.identity;id='org.eclipse.xsd';version='[2.20.0,3.0.0)',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.ecore.xmi',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.uml',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.apicurio',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.file',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.lucene',\
	bnd.identity;id='org.eclipse.fennec.codec.jsonschema',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.jsonschema'
	
-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'
-runee: JavaSE-21

-runstartlevel: \
    order = sortbynameversion, \
    begin = 1000, \
    step  =    1

-runproperties.base: \
	org.osgi.service.http.port=-1,\
	felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation

-runblacklist: \
	bnd.identity;id='org.gecko.emf.osgi.component.minimal',\
	bnd.identity;id='org.gecko.emf.osgi.component.config',\
	bnd.identity;id='org.gecko.emf.osgi.api',\
	bnd.identity;id='jakarta.servlet-api'


