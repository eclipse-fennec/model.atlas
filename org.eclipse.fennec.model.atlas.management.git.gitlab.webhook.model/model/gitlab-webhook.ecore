<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="gitlabwebhook" nsURI="http://eclipse.org/fennec/model/atlas/management/gitlab/webhook/1.0.0"
    nsPrefix="gitlabwebhook">
  <eAnnotations source="Version">
    <details key="value" value="1.0"/>
