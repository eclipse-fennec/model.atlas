<?xml version="1.0" encoding="UTF-8"?>
<genmodel:GenModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:genmodel="http://www.eclipse.org/emf/2002/GenModel" copyrightText="Copyright (c) 2012 - 2026 Data In Motion and others.&#xA;All rights reserved.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0&#xA;&#xA;Contributors:&#xA;    Data In Motion - initial API and implementation"
    modelDirectory="/org.eclipse.fennec.model.atlas.management.git.gitlab.webhook.model/src"
    modelPluginID="org.eclipse.fennec.model.atlas.management.git.gitlab.webhook.model"
    modelName="gitlab-webhook" rootExtendsClass="org.eclipse.emf.ecore.impl.MinimalEObjectImpl$Container"
    importerID="org.eclipse.emf.importer.ecore" complianceLevel="17.0" suppressGenModelAnnotations="false"
    copyrightFields="false" usedGenPackages="../../org.eclipse.fennec.model.atlas.management.git.webhook.model/model/git-webhook.genmodel#//gitwebhook"
    operationReflection="true" importOrganizing="true" oSGiCompatible="true">
  <foreignModel>gitlab-webhook.ecore</foreignModel>
  <genPackages prefix="GitlabWebhook" basePackage="org.eclipse.fennec.model.atlas.management.git.gitlab.webhook.model"
      resource="XMI" disposableProviderFactory="true" ecorePackage="gitlab-webhook.ecore#/">
    <genClasses ecoreClass="gitlab-webhook.ecore#//GitlabPayload">
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference gitlab-webhook.ecore#//GitlabPayload/project"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference gitlab-webhook.ecore#//GitlabPayload/commits"/>
      <genOperations ecoreOperation="gitlab-webhook.ecore#//GitlabPayload/getProvider"
          body="return GitProvider.GITLAB;"/>
      <genOperations ecoreOperation="gitlab-webhook.ecore#//GitlabPayload/getCloneUrl"
          body="return getProject() == null ? null : getProject().getGitHttpUrl();"/>
      <genOperations ecoreOperation="gitlab-webhook.ecore#//GitlabPayload/getRepositoryFullName"
          body="return getProject() == null ? null : getProject().getPathWithNamespace(); "/>
      <genOperations ecoreOperation="gitlab-webhook.ecore#//GitlabPayload/getAddedPaths"
          body="java.util.LinkedHashSet&lt;String> paths = new java.util.LinkedHashSet&lt;>();&#xA;for (Commit c : getCommits()) {&#xA;&#x9;paths.addAll(c.getAdded());&#xA; }&#xA;return new org.eclipse.emf.common.util.BasicEList&lt;>(paths);"/>
      <genOperations ecoreOperation="gitlab-webhook.ecore#//GitlabPayload/getModifiedPaths"
          body="java.util.LinkedHashSet&lt;String> paths = new java.util.LinkedHashSet&lt;>();&#xA;for (Commit c : getCommits()) {&#xA;&#x9;paths.addAll(c.getModified());&#xA; }&#xA;return new org.eclipse.emf.common.util.BasicEList&lt;>(paths);"/>
      <genOperations ecoreOperation="gitlab-webhook.ecore#//GitlabPayload/getRemovedPaths"
          body="java.util.LinkedHashSet&lt;String> paths = new java.util.LinkedHashSet&lt;>();&#xA;for (Commit c : getCommits()) {&#xA;&#x9;paths.addAll(c.getRemoved());&#xA; }&#xA;return new org.eclipse.emf.common.util.BasicEList&lt;>(paths);"/>
    </genClasses>
    <genClasses ecoreClass="gitlab-webhook.ecore#//Project">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute gitlab-webhook.ecore#//Project/gitHttpUrl"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute gitlab-webhook.ecore#//Project/pathWithNamespace"/>
    </genClasses>
  </genPackages>
</genmodel:GenModel>
