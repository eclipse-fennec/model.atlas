-workingset: workflow
-library: \
	enableEMF
	
-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.osgi.util.function;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.eclipse.fennec.model.atlas.management;version=snapshot,\
	org.eclipse.fennec.model.atlas.management.apicurio.model;version=snapshot,\
	org.apache.felix.healthcheck.api,\
	org.eclipse.fennec.codec.api;version=latest,\
	org.eclipse.fennec.codec;version=latest

Bundle-Name: MAC Management Apicurio Storage Implementation
Bundle-Description: Apicurio-based storage implementation for EPackage workflow management
