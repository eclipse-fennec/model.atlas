-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.data.atlas.jpa.rest.tests',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.jpa.rest',\
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.h2',\
	bnd.identity;id='com.h2database',\
	bnd.identity;id='org.apache.felix.gogo.runtime',\
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component',\
	bnd.identity;id='org.eclipse.daanse.io.fs.watcher.watchservice',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.jpa.watcher',\
	bnd.identity;id='org.eclipse.daanse.sql.dialect.db.h2',\
	bnd.identity;id='org.eclipse.persistence.jpa.jpql',\
	bnd.identity;id='org.eclipse.fennec.persistence.eclipselink';version=latest,\
	bnd.identity;id='org.eclipse.fennec.codec',\
	bnd.identity;id='org.eclipse.daanse.sql.jdbc.importer.csv',\
	bnd.identity;id='org.eclipse.daanse.sql.jdbc.impl',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.epackage.watcher',\
	bnd.identity;id='org.eclipse.fennec.codec.rest'
	

-runprovidedcapabilities: ${native_capability}

-resolve.effective: active;skip:="osgi.service"


-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'

-runee: JavaSE-25

-runproperties: \
	org.osgi.service.http.port=-1,\
	logback.configurationFile=file:${.}/logback.xml,\
	geckotest=true,\
	gecko.log.level=INFO,\
	${if;${is;${driver};gradle};gosh.args=--nointeractive},\
	data-folder=${.}/data/,\
	jakarta.persistence.schema-generation.create-database-schemas=true
	
# Ensure clean environment
-runkeep: false


-runbundles: \
	com.h2database;version='[2.3.232,2.3.233)',\
	io.swagger.core.v3.swagger-annotations;version='[2.2.28,2.2.29)',\
