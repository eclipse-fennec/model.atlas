          <feature xsi:type="ecore:EAttribute" href="http://example.org/jpa/demo/1.0#//Payment/paymentDate"/>
        </accessibleObject>
        <column insertable="true" name="payment_date" nullable="true" unique="false" updatable="true" columnDefinition="VARCHAR(20)"/>
      </basic>
      <basic access="FIELD" name="method" fetch="EAGER" optional="true">
        <accessibleObject xsi:type="eorm:EFeatureObject" name="method">
          <feature xsi:type="ecore:EAttribute" href="http://example.org/jpa/demo/1.0#//Payment/method"/>
        </accessibleObject>
        <column insertable="true" name="method" nullable="true" unique="false" updatable="true" columnDefinition="VARCHAR(50)"/>
