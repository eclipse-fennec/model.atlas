-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.model.atlas.bootstrap.tests',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.bootstrap',\
	bnd.identity;id='org.eclipse.fennec.codec.jsonschema',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.file',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.lucene',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component'

-runblacklist: \
	bnd.identity;id='org.eclipse.uml2.uml';version='[0.0.0,5.6.0)',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.apicurio',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal'

-runbundles.test: \
	org.eclipse.fennec.model.atlas.bootstrap.tests;version=snapshot

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'

-runee: JavaSE-21

-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.scr;version='[2.2.14,2.2.15)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.codec;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.api;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.jsonschema;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.metadata;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.emf.osgi.component.minimal;version='[0.1.2,0.1.3)',\
	org.eclipse.fennec.model.atlas.bootstrap;version=snapshot,\
	org.eclipse.fennec.model.atlas.bootstrap.tests;version=snapshot,\
	org.eclipse.fennec.model.atlas.emf.common;version=snapshot,\
	org.eclipse.fennec.model.metadata;version='[0.1.0,0.1.1)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.service.cm;version='[1.6.1,1.6.2)',\
	org.osgi.test.common;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5.cm;version='[1.3.0,1.3.1)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	tools.jackson.core.jackson-core;version='[3.1.0,3.1.1)',\
	tools.jackson.core.jackson-databind;version='[3.1.0,3.1.1)'
