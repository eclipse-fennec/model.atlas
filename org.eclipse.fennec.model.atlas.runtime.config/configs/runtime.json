{
	":configurator:resource-version": 1,
	":configurator:symbolicname": "org.civitas.meter.runtime",
	":configurator:version": "0.0.0",
	"JakartarsServletWhiteboardRuntimeComponent~atlasRest": {
		"jersey.jaxrs.whiteboard.name": "atlasRest",
		"jersey.context.path": "rest",
		"osgi.http.whiteboard.target": "(id=atlasHttp)"
	},
	"ModelDocumentationProvider~docProvider" : {
		"output.root.folder" : "./data/model/documentation/",
		"output.md.folder" : "md",
		"output.md.mermaid.folder" : "md_mermaid",
		"output.md.plantuml.folder" : "md_plantuml",
		"output.html.folder" : "html",
		"output.html.mermaid.folder" : "html_mermaid",
		"output.package.hash.code.folder": "epackage_hash_code"
	},
	"org.apache.felix.hc.core.impl.servlet.HealthCheckExecutorServlet~atlas": {
		"osgi.http.whiteboard.servlet.pattern": "/health/*",
		"osgi.http.whiteboard.target": "(id=atlasHttp)",
		"hc.tags": ["atlas"],
		"format": "json",
		"includeExecutionResult": true,
		"httpStatus.ok": 200,
		"httpStatus.warn": 200,
		"httpStatus.critical": 503,
		"httpStatus.temporarilyUnavailable": 503
	}
}
