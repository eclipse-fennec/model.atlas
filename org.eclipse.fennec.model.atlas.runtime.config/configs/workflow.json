{
	":configurator:resource-version": 1,
	":configurator:version": "1.0.0",
	"EObjectWorkflowService~atlas": {
		"workflow.id": "atlas-workflow",
		"scope": "atlas",
		"description": "Atlas workflow",
		"parent.scope": "",
		"parentWorkflowService.targer": "(scope=no-inject)",
		"delete.after.transition": true,
		"stages": ["draft", "approved", "release"],
		"final.stage": "release",
		"writable.stages": ["draft", "approved"],
		"registryService.target": "(registry=main)"
	},
	"EObjectWorkflowService~package": {
		"workflow.id": "package-workflow",
		"scope": "default",
		"description": "Test package workflow",
		"parent.scope": "atlas",
		"parentWorkflowService.targer": "(scope=atlas)",
		"delete.after.transition": true,
		"stages": ["draft", "approved", "release"],
		"final.stage": "release",
		"writable.stages": ["draft", "approved", "release"],
		"registryService.target": "(registry=main)"
	}
}
