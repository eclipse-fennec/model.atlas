Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}

-library: \
	enableOSGi-Test,\
	enableEMF

# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.service.jakartars;version=latest,\
	org.osgi.util.tracker;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.eclipse.fennec.model.atlas.management,\
	org.osgi.test.junit5.cm;version=latest,\
	jakarta.ws.rs-api;version=latest,\
	org.eclipse.fennec.model.atlas.datagen.example.model;version=snapshot,\
	org.eclipse.fennec.model.atlas.validation.model;version=snapshot,\
	org.eclipse.fennec.model.atlas.workflow;version=snapshot,\
	org.osgi.util.promise;version=latest,\
	org.eclipse.fennec.m2x.ocl.api;version=latest,\
	org.eclipse.fennec.model.atlas.tests.common;version=snapshot,\
	org.eclipse.fennec.model.atlas.scope.api;version=snapshot
	
Private-Package: \
	org.eclipse.fennec.model.atlas.validation.rest.tests,\
	org.eclipse.fennec.model.atlas.validation.rest.tests.helper


-includeresource: \
	OSGI-INF/configurator/=configs/

Require-Capability: osgi.extender;filter:='(osgi.extender=osgi.configurator)'

# Sometimes without DynamicImport Mockito will not find certain classes
#DynamicImport-Package: *

# Do not publish this bundle to Maven Central; local install only
-maven-release: local
