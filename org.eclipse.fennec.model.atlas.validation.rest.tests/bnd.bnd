Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}

-library: \
	enableOSGi-Test,\
	enableEMF

# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.service.jakartars,\
	org.osgi.util.tracker,\
	org.osgi.service.cm,\
	org.eclipse.fennec.model.atlas.management,\
	org.osgi.test.junit5.cm,\
	jakarta.ws.rs-api,\
	org.eclipse.fennec.model.atlas.datagen.example.model,\
	org.eclipse.fennec.model.atlas.validation.model,\
	org.eclipse.fennec.model.atlas.workflow,\
	org.osgi.util.promise,\
	org.eclipse.fennec.m2x.ocl.api,\
	org.eclipse.fennec.model.atlas.tests.common
	
Private-Package: \
	org.eclipse.fennec.model.atlas.validation.rest.tests,\
	org.eclipse.fennec.model.atlas.validation.rest.tests.helper

Bundle-Version: 1.0.0.SNAPSHOT

-includeresource: \
	OSGI-INF/configurator/=configs/

Require-Capability: osgi.extender;filter:='(osgi.extender=osgi.configurator)'

# Sometimes without DynamicImport Mockito will not find certain classes
#DynamicImport-Package: *