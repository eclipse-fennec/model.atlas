-library: enableOSGi-Test

-runproperties: \
	org.osgi.service.http.port=-1,\
	geckotest=true,\
	gecko.log.level=INFO,\
	${if;${is;${driver};gradle};gosh.args=--nointeractive}

-runvm: \
	-ea

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.model.atlas.validation.rest.tests',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.validation.rest',\
	bnd.identity;id='org.apache.aries.typedevent.bus',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.mediatypes.impl',\
	bnd.identity;id='org.eclipse.fennec.m2x.ocl.engine',\
	bnd.identity;id='org.eclipse.fennec.codec.rest',\
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.filter',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component',\
	bnd.identity;id='org.eclipse.fennec.codec',\
	bnd.identity;id='org.eclipse.fennec.codec.metadata',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.model.info'
	
-runbundles.test: \
	org.eclipse.fennec.model.atlas.validation.rest.tests;version=snapshot

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'

-runee: JavaSE-21


	
# The framework-extension spifly variant installs a weaving hook that breaks class loading in
# other bundles ("Weaving hook failed"): felix.http.jetty, the aries typedevent bus and daanse's
# PathWatcherService have all been taken out by it. Listing spifly.dynamic.bundle in -runbundles
# is not enough - testOSGi runs the RESOLVED bndrun and the resolver swaps the variant in.
-runblacklist: \
    bnd.identity;id='org.eclipse.uml2.uml';version='[0.0.0,5.6.0)',\
    bnd.identity;id='org.eclipse.fennec.model.atlas.management.apicurio',\
    bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'
-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)',\
	io.swagger.core.v3.swagger-annotations;version='[2.2.28,2.2.29)',\
	jakarta.activation-api;version='[2.1.3,2.1.4)',\
	jakarta.annotation-api;version='[2.1.1,2.1.2)',\
	jakarta.inject.jakarta.inject-api;version='[2.0.1,2.0.2)',\
	jakarta.validation.jakarta.validation-api;version='[3.0.2,3.0.3)',\
	jakarta.ws.rs-api;version='[3.1.0,3.1.1)',\
	jakarta.xml.bind-api;version='[4.0.2,4.0.3)',\
	javassist;version='[3.29.2,3.29.3)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	org.antlr.antlr4-runtime;version='[4.13.2,4.13.3)',\
