Bundle-Name: Eclipse Fennec Model Atlas MCP Tools
Bundle-Description: MCP tools writing to a model.atlas draft stage: one publishing a \
 session-registered EPackage, so an inferred model leaves the runtime without its XMI ever passing \
 through the LLM, and one storing an agent-supplied object in a configured object registry.

-workingset: mcp

# The tools are the MCP surface and nothing else: what they call is
# org.eclipse.fennec.model.atlas.publisher, where the destination, the wire format
# and the authorization decision live. Deploying THAT bundle and configuring a
# publisher is what lets a runtime write at all; a tool with no publisher to bind
# to never activates.
-buildpath: \
	io.modelcontextprotocol.sdk.mcp-core;version=latest,\
	io.projectreactor.reactor-core;version=latest,\
	reactive-streams;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\
	tools.jackson.core.jackson-core;version=latest,\
	com.fasterxml.jackson.core.jackson-annotations;version=latest,\
	org.eclipse.fennec.mcp.api;version=latest,\
	org.osgi.framework;version=latest,\
	org.eclipse.fennec.model.atlas.publisher;version=latest

# EMF is not compiled against here any more — the tools handle strings — but
# AbstractMCPTool resolves EMF types, so loading a tool in a plain JUnit test
# still needs them on the class path.
-testpath: \
	assertj-core,\
	org.eclipse.emf.common;version=latest,\
	org.eclipse.emf.ecore;version=latest
