-library: enableOSGi-Test

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'

-runee: JavaSE-21

-runproperties: \
	org.osgi.service.http.port=-1,\
	logback.configurationFile=file:${.}/logback.xml,\
	geckotest=true,\
	gecko.log.level=INFO,\
	${if;${is;${driver};gradle};gosh.args=--nointeractive}

-runtrace: false

-runvm: \
	-ea

-resolve.effective: active

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.filter',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.filter.tests',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal',\
	bnd.identity;id='org.apache.felix.gogo.runtime',\
	bnd.identity;id='org.apache.felix.gogo.shell'

# Ensure clean environment
-runkeep: false

-runblacklist: \
	bnd.identity;id='org.eclipse.uml2.uml';version='[0.0.0,5.6.0)',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.apicurio'
-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)',\
	jakarta.activation-api;version='[2.1.3,2.1.4)',\
	jakarta.annotation-api;version='[2.1.1,2.1.2)',\
	jakarta.inject.jakarta.inject-api;version='[2.0.1,2.0.2)',\
	jakarta.validation.jakarta.validation-api;version='[3.0.2,3.0.3)',\
	jakarta.ws.rs-api;version='[3.1.0,3.1.1)',\
	jakarta.xml.bind-api;version='[4.0.2,4.0.3)',\
	javassist;version='[3.29.2,3.29.3)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-engine;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	junit-platform-engine;version='[1.14.2,1.14.3)',\
	junit-platform-launcher;version='[1.14.2,1.14.3)',\
	net.bytebuddy.byte-buddy;version='[1.18.4,1.18.5)',\
	net.bytebuddy.byte-buddy-agent;version='[1.18.4,1.18.5)',\
	org.apache.aries.component-dsl.component-dsl;version='[1.2.2,1.2.3)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.apache.aries.typedevent.bus;version='[1.0.1,1.0.2)',\
	org.apache.felix.cm.json;version='[2.0.6,2.0.7)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)',\
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)',\
	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)',\
	org.apache.felix.http.jetty12;version='[1.0.34,1.0.35)',\
