{
    ":configurator:resource-version": 1,
    ":configurator:version": "1.0.0",
    "EPackageStageActionService": {
        "trigger.stages": ["draft", "approved", "release"],
        "storageService.target": "(storage.type=file)"
    },
    "QvtStageActionService": {
        "trigger.stages": ["draft", "approved", "release"]
    },
    "GDPRCheckStageAction": {
        "trigger.stages": ["approved"],
        "review.on.update": false
    },
    "GDPRReportHistoryStageAction": {
        "reports.registry": "gdpr",
        "report.stages": ["draft", "release"],
        "trigger.scopes": ["jena"],
        "scope.target": "(atlas.scope=jena)",
        "document.registry": "gdprdoc",
        "document.stage": "draft"
    },
    "ModelAtlasObjectPublisher~gdprStatus": {
        "base.uri": "http://localhost:8080/atlas/rest",
        "scope": "jena",
        "registry": "gdpr",
        "stage": "draft",
        "content.type": "application/json",
        "overwrite": true
    },
    "GDPRAtlasRequestStatusStore": {
        "registry": "gdpr",
        "stage": "draft",
        "scope.target": "(atlas.scope=jena)",
        "publisher.target": "(&(scope=jena)(registry=gdpr))"
    },
    "ScopeService~jena": {
    	"atlas.scope": "jena",
        "scope.name": "jena",
        "scope.description": "City Jena Scope",
        "scope.parent": "atlas",
        "registryService.target": "(|(registry.name=schema)(registry.name=workspace)(registry.name=DataGen)(registry.name=cocl)(registry.name=sensinactmapping)(registry.name=sensinactprofile)(registry.name=transformations)(registry.name=gdpr)(registry.name=gdprdoc))",
        "registryService.cardinality.minimum:int": 1
    },
    "RegistryService~transformations": {
        "schemaPackage.target": "(emf.nsURI=http://www.eclipse.org/fennec/m2x/compiled/1.0)",
        "registry.type": "TRANSFORMATION",
        "registry.name": "transformations",
        "registry.description": "QVT-O transformation sources, compiled units and their diagnostics (issue #239)",
        "stageActionService.target": "(component.name=QvtStageActionService)",
        "stageActionService.cardinality.minimum:int": 1,
        "stageGate.target": "(component.name=QvtTransitionGate)",
        "stageGate.cardinality.minimum:int": 1,
        "stage.storage.mappings": [
            "draft:file",
            "approved:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:approved",
            "approved:release"
        ],
        "delete.after.transition": false,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "approved",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "root.eclass.uri": [
            "http://www.eclipse.org/fennec/m2x/compiled/1.0#//SourceUnit"
        ],
        "derived.eclass.uri": [
            "http://www.eclipse.org/fennec/m2x/compiled/1.0#//CompiledUnit",
            "http://eclipse.org/fennec/model/atlas/qvt/diagnostics/1.0.0#//SourceDiagnostics"
        ],
        "resourceSet.target": "(&(emf.name=compiled)(emf.name=diagnostics))"
    },
    "RegistryService~schema": {
        "registry.type": "SCHEMA",
        "registry.name": "schema",
        "registry.description": "The schema registry to store EPackage objects",
        "stageActionService.target": "(|(component.name=EPackageStageActionService)(component.name=GDPRCheckStageAction)(component.name=SchemaDependencyStageAction))",
        "stageGate.target": "(component.name=SchemaDeleteGate)",
