<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="jpamapping" nsURI="http://eclipse.org/fennec/data/atlas/jpamapping/1.0.0"
    nsPrefix="jpamapping">
  <eAnnotations source="Version">
    <details key="value" value="1.0"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="complianceLevel" value="17.0"/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.fennec.data.atlas.mapping.model"/>
    <details key="resource" value="XMI"/>
    <details key="documentation" value="Root package for the JPA mapping configuration model. Describes how EMF model classes and features are mapped to relational database tables and columns."/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="JpaMappingConfig">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Top-level configuration that binds a target EMF model (identified by its namespace URI) to a data source and a set of table mappings."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The configuration name/id."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetModelNsUri" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The namespace URI of the EMF EPackage that this mapping configuration targets (e.g. 'http://example.org/mymodel/1.0.0')."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dataSource" eType="#//DataSourceConfig"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The JDBC data source configuration used to connect to the relational database."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tableMappings" upperBound="-1"
        eType="#//TableMapping" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The list of table mappings that describe how each EMF class is persisted in the database."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DataSourceConfig">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="JDBC data source configuration, including connection URL, credentials, connection pool settings, and the SQL dialect to use."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="driverClass" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Fully qualified class name of the JDBC driver (e.g. 'org.postgresql.Driver')."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="jdbcUrl" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JDBC connection URL (e.g. 'jdbc:postgresql://localhost:5432/mydb')."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="username" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Database user name used to authenticate the JDBC connection."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="passwordRef" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Reference key or environment variable name from which the database password is resolved at runtime, avoiding plain-text secrets in the configuration."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="poolSize" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Maximum number of connections maintained in the connection pool."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dialect" eType="#//SqlDialect">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="SQL dialect of the target database, used to generate dialect-specific SQL statements."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TableMapping">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Describes the mapping between a single EMF EClass and a relational database table, including its column and join mappings."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="className" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Full EMF URI of the EClass being mapped, in the form 'nsURI#//ClassName' (e.g. 'https://dg.de/1.0#//Customer')."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tableName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Name of the database table to which the EMF class is mapped."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="schema" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="PUBLIC">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Optional database schema that qualifies the table name (e.g. 'public' in PostgreSQL). Leave empty to use the default schema."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="columnMappings" upperBound="-1"
        eType="#//ColumnMapping" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Mappings from EMF scalar features (EAttributes) to individual database columns."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="joinMappings" upperBound="-1"
        eType="#//JoinMapping" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Mappings from EMF references (EReferences) to relational join strategies (foreign key or embedded)."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ColumnMapping">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Describes the mapping between a single EMF EAttribute and a relational database column."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="featureName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Name of the EMF EAttribute being mapped (as declared in the EClass)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="columnName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Name of the database column that stores the attribute value."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="columnType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="SQL data type of the column (e.g. 'VARCHAR(255)', 'INTEGER', 'TIMESTAMP'). If omitted, the type is inferred from the EAttribute type."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nullable" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the column accepts NULL values. Set to false to enforce a NOT NULL constraint."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="primaryKey" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether this column is the primary key of the table. Exactly one ColumnMapping per TableMapping should have this set to true. The converter will map it to a JPA @Id field in the EORM."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="JoinMapping">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Describes how an EMF EReference is persisted relationally, either via a foreign key column or by embedding the referenced object's columns into the owning table."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="referenceName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Name of the EMF EReference being mapped (as declared in the EClass)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="joinColumn" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Name of the foreign key column in the owning table (for FOREIGN_KEY join type), or the column prefix used when embedding referenced fields (for EMBEDDED join type)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="joinType" eType="#//JoinType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Strategy used to represent the relationship in the database: FOREIGN_KEY for a standard FK column, or EMBEDDED to inline the referenced object's fields."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cascadeType" upperBound="-1"
        eType="#//CascadeType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="JPA cascade operations that are propagated from the owning entity to the associated entity. Multiple values can be combined (e.g. PERSIST + MERGE). Use ALL to enable all operations at once."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="SqlDialect">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Identifies the SQL dialect of the target relational database, allowing the runtime to generate dialect-specific DDL and DML statements."/>
    </eAnnotations>
    <eLiterals name="H2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="H2 in-memory/embedded database (typically used for testing)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="POSTGRES" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="PostgreSQL relational database."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MYSQL" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="MySQL / MariaDB relational database."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="ORACLE" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Oracle Database."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="SQLSERVER" value="4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Microsoft SQL Server."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="OTHER" value="5">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Any other SQL database not explicitly listed. Generic SQL will be generated."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="JoinType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Strategy used to represent an EMF EReference relationship in a relational database table."/>
    </eAnnotations>
    <eLiterals name="FOREIGN_KEY">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The relationship is stored as a foreign key column in the owning table pointing to the primary key of the referenced table."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="EMBEDDED" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The referenced object's fields are inlined as columns directly into the owning table (JPA @Embedded semantics)."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="CascadeType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Mirrors jakarta.persistence.CascadeType. Defines which JPA entity lifecycle operations are automatically propagated from the owning entity to the associated entity."/>
    </eAnnotations>
    <eLiterals name="ALL">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Shorthand for enabling all cascade operations (PERSIST, MERGE, REMOVE, REFRESH, DETACH)."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="PERSIST" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cascades EntityManager.persist(): when the owning entity is persisted, the associated entity is also persisted."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="MERGE" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cascades EntityManager.merge(): when the owning entity is merged, the associated entity is also merged."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="REMOVE" value="3">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cascades EntityManager.remove(): when the owning entity is deleted, the associated entity is also deleted."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="REFRESH" value="4">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cascades EntityManager.refresh(): when the owning entity is refreshed from the database, the associated entity is also refreshed."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="DETACH" value="5">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Cascades EntityManager.detach(): when the owning entity is detached from the persistence context, the associated entity is also detached."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
</ecore:EPackage>
