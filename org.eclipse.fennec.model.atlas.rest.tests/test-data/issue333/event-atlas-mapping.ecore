    <eStructuralFeatures xsi:type="ecore:EReference" name="extraMetadata" upperBound="-1"
        eType="#//StringToStringMap" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="descriptionMapping" eType="#//NameMapping"
        derived="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="changeRule" eType="#//ChangeRule"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Optional change rule deciding whether a value change of this resource is stored.&#xA;Contained: the rule belongs to this resource alone. Two resources that behave alike each carry&#xA;their own copy, so changing a threshold means editing every resource that uses it.&#xA;Because the declared type is abstract, an XMI element must name the concrete rule, e.g.&#xA;xsi:type=&quot;mapping:PercentageChangeRule&quot;."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="deletionRule" eType="#//DeletionRule"
        containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Optional deletion rule controlling purging of this resource's stored history data.&#xA;Contained: the rule belongs to this resource alone. Nothing enforces deletion rules yet."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
