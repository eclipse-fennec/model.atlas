        <details key="body" value="&lt;%java.util.Objects%>.requireNonNull(idFunction);&#xA;Objects.requireNonNull(eobject);&#xA;setMid(idFunction.apply(eobject));"/>
      </eAnnotations>
      <eParameters name="idFunction" lowerBound="1" eType="#//JavaStringFunction"/>
      <eParameters name="eobject" lowerBound="1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EObject"/>
    </eOperations>
    <eOperations name="mapName">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="&lt;%java.util.Objects%>.requireNonNull(nameFunction);&#xA;Objects.requireNonNull(eobject);&#xA;NameMapping name = &lt;%org.eclipse.fennec.event.atlas.model.mapping.MappingFactory%>.eINSTANCE.createNameMapping();&#xA;name.setName(nameFunction.apply(eobject));&#xA;setName(name);"/>
      </eAnnotations>
      <eParameters name="nameFunction" lowerBound="1" eType="#//JavaStringFunction"/>
      <eParameters name="eobject" lowerBound="1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EObject"/>
