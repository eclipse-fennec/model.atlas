{
    ":configurator:resource-version": 1,
    ":configurator:symbolic-name": "org.eclipse.fennec.model.atlas.config.jena",
    ":configurator:version": "1.0.0",
    "FileObjectStorage~file": {
        "workspace.folder": "$[env:STORAGE_ROOT;default=/opt/modelatlas/runtime/data]",
        "storage.type": "file",
        "registry.target": "(registry=main)"
    },
    "ScopeService~jena": {
        "scope.name": "jena",
        "atlas.scope": "jena",
        "scope.description": "City Jena Scope",
        "parent.scope": "atlas",
        "registryService.target": "(|(registry.name=schema)(registry.name=workspace)(registry.name=DataGen)(registry.name=cocl)(registry.name=sensinactmapping)(registry.name=sensinactprofile))",
        "registryService.cardinality.minimum:int": 1
    },
    "RegistryService~schema": {
        "registry.type": "SCHEMA",
        "registry.name": "schema",
        "registry.description": "The schema registry to store EPackage objects",
        "stageActionService.target": "(component.name=EPackageStageActionService)",
        "stage.storage.mappings": [
            "draft:file",
            "approved:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:approved",
            "approved:release",
            "release:draft",
            "approved:draft"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "approved",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "http://www.eclipse.org/emf/2002/Ecore",
        "root.eclass.uri": "http://www.eclipse.org/emf/2002/Ecore#//EPackage",
        "resourceSet.target": "(emf.name=ecore)"
    },
    "RegistryService~workspace": {
        "registry.name": "workspace",
        "registry.description": "The general registry to store EObjects",
        "stage.storage.mappings": [
            "draft:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "http://www.eclipse.org/emf/2002/Ecore",
        "root.eclass.uri": "http://www.eclipse.org/emf/2002/Ecore#//EObject",
        "resourceSet.target": "(emf.name=ecore)"
    },
    "RegistryService~datagen": {
        "registry.name": "DataGen",
        "registry.description": "The DataGen Registry to store DataGenConfig objects",
        "stage.storage.mappings": [
            "draft:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
