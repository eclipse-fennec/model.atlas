            }
        ],
        "schema.uri": "https://fennec.eclipse.org/event.atlas/mapping/1.0",
        "root.eclass.uri": "https://fennec.eclipse.org/event.atlas/mapping/1.0#//ProviderMapping",
        "resourceSet.target": "(emf.name=ecore)"
    },
    "RegistryService~sensinactprofile": {
        "registry.type": "OTHER",
        "registry.name": "sensinactprofile",
        "registry.description": "The Registry to store MappingProfile objects",
        "stage.storage.mappings": [
