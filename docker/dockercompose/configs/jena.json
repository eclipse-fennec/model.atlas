            "draft:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "http://www.gme.org/cocl/1.0",
        "root.eclass.uri": "http://www.gme.org/cocl/1.0#//OclConstraintSet",
        "resourceSet.target": "(emf.name=ecore)"
    },
    "RegistryService~sensinactmapping": {
        "registry.type": "OTHER",
        "registry.name": "sensinactmapping",
        "registry.description": "The Registry to store ProviderMapping objects",
        "stage.storage.mappings": [
            "draft:file",
            "release:file"
        ],
