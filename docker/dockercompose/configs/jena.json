            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "https://fennec.eclipse.org/event.atlas/mapping/1.0",
        "root.eclass.uri": "https://fennec.eclipse.org/event.atlas/mapping/1.0#//MappingProfile",
        "resourceSet.target": "(emf.name=ecore)"
    }
}
