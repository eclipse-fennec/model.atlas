{
    ":configurator:resource-version": 1,
    ":configurator:version": "1.0.0",
    "EPackagePostReleaseActionService": {
        "releaseStorage.target": "(storage.type=file)"
    },
    "ScopeService~atlas": {
        "scope.name": "atlas",
        "scope.description": "Atlas scope. The parent of all other scopes.",
        "parent.scope": "",
        "registryService.target": "(|(registry.name=schema)(registry.name=ocl)(registry.name=qvt))",
        "registryService.cardinality.minimum:int": 1
    },
    "ScopeService~jena": {
        "scope.name": "jena",
        "scope.description": "City Jena Scope",
        "parent.scope": "atlas",
        "registryService.target": "(|(registry.name=schema)(registry.name=ocl)(registry.name=qvt))",
        "registryService.cardinality.minimum:int": 1
    },
    "RegistryService~schema": {
        "registry.name": "schema",
        "registry.description": "The schema registry to store EPackage objects",
        "postReleaseActionService.target": "(component.name=EPackagePostReleaseActionService)",
        "stage.storage.mappings": [
            "draft:file",
            "approved:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:approved",
            "approved:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "approved",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "http://www.eclipse.org/emf/2002/Ecore",
        "root.eclass.uri": "http://www.eclipse.org/emf/2002/Ecore#//EPackage",
        "resourceSet.target": "(emf.name=ecore)"
    },
    "RegistryService~ocl": {
        "registry.name": "ocl",
        "registry.description": "The OCL registry to store OCL expressions",
        "stage.storage.mappings": [
            "draft:file",
            "approved:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "http://www.eclipse.org/emf/2002/Ecore",
        "root.eclass.uri": "http://www.eclipse.org/emf/2002/Ecore#//EObject",
        "resourceSet.target": "(emf.name=ecore)"
    },
    "RegistryService~qvt": {
        "registry.name": "qvt",
        "registry.description": "The QVT registry to store QVT mapping templates",
        "stage.storage.mappings": [
            "draft:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "http://www.eclipse.org/emf/2002/Ecore",
        "root.eclass.uri": "http://www.eclipse.org/emf/2002/Ecore#//EObject",
        "resourceSet.target": "(emf.name=ecore)"
    }
}
