{
    ":configurator:resource-version": 1,
    ":configurator:version": "1.0.0",
    "EPackagePostReleaseActionService": {
        "releaseStorage.target": "(storage.type=file)"
    },
    "ScopeService~jena": {
        "scope.name": "jena",
        "scope.description": "City Jena Scope",
        "parent.scope": "atlas",
        "registryService.target": "(|(registry.name=schema)(registry.name=workspace)(registry.name=DataGen)(registry.name=cocl))",
        "registryService.cardinality.minimum:int": 1
    },
    "RegistryService~schema": {
        "registry.type": "SCHEMA",
        "registry.name": "schema",
        "registry.description": "The schema registry to store EPackage objects",
        "postReleaseActionService.target": "(component.name=EPackagePostReleaseActionService)",
        "stage.storage.mappings": [
            "draft:file",
            "approved:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:approved",
            "approved:release",
            "release:draft",
            "approved:draft"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "approved",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "http://www.eclipse.org/emf/2002/Ecore",
        "root.eclass.uri": "http://www.eclipse.org/emf/2002/Ecore#//EPackage",
        "resourceSet.target": "(emf.name=ecore)"
    },
    "RegistryService~workspace": {
        "registry.name": "workspace",
        "registry.description": "The general registry to store EObjects",
        "stage.storage.mappings": [
            "draft:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "http://www.eclipse.org/emf/2002/Ecore",
        "root.eclass.uri": "http://www.eclipse.org/emf/2002/Ecore#//EObject",
        "resourceSet.target": "(emf.name=ecore)"
    },
    "RegistryService~datagen": {
        "registry.name": "DataGen",
        "registry.description": "The DataGen Registry to store DataGenConfig objects",
        "stage.storage.mappings": [
            "draft:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "http://www.gme.org/datagen/1.0",
        "root.eclass.uri": "http://www.gme.org/datagen/1.0#//DataGenConfig",
        "resourceSet.target": "(emf.name=ecore)"
    },
    "RegistryService~ocl": {
        "registry.type": "COCL",
        "registry.name": "cocl",
        "registry.description": "The cocl Registry to store OclConstraintSet objects",
        "stage.storage.mappings": [
            "draft:file",
            "release:file"
        ],
        "workflow.transitions": [
            "draft:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=file)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "http://www.gme.org/cocl/1.0",
        "root.eclass.uri": "http://www.gme.org/cocl/1.0#//OclConstraintSet",
        "resourceSet.target": "(emf.name=ecore)"
    }
