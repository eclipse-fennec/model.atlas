{
    ":configurator:resource-version": 1,
    ":configurator:version": "1.0.0",
    "EPackageStageActionService": {
        "trigger.stages": ["draft", "approved", "release"],
        "storageService.target": "(storage.type=apicurio)"
    },
    "ScopeService~civitas": {
        "scope.name": "civitas",
        "scope.description": "Civitas Scope",
        "parent.scope": "atlas",
        "registryService.target": "(|(registry.name=schema)(registry.name=default))",
        "registryService.cardinality.minimum:int": 1
    },
    
    "RegistryService~schema": {
        "registry.type": "SCHEMA",
        "registry.name": "schema",
        "registry.description": "The schema registry to store EPackage objects",
        "stageActionService.target": "(component.name=EPackageStageActionService)",
        "stage.storage.mappings": [
            "draft:apicurio",
            "approved:apicurio",
            "release:apicurio"
        ],
        "workflow.transitions": [
            "draft:approved",
            "approved:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=apicurio)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "approved",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "http://www.eclipse.org/emf/2002/Ecore",
        "root.eclass.uri": "http://www.eclipse.org/emf/2002/Ecore#//EPackage",
        "resourceSet.target": "(emf.name=ecore)"
    },
    "RegistryService~default": {
        "registry.name": "default",
        "registry.description": "The person registry to store Person objects",
        "stage.storage.mappings": [
            "draft:apicurio",
            "approved:apicurio",
            "release:apicurio"
        ],
        "workflow.transitions": [
            "draft:approved",
            "approved:release"
        ],
        "delete.after.transition": true,
        "storageService.target": "(storage.type=apicurio)",
        "storageService.cardinality.minimum:int": 1,
        "stages": [
            {
                "name": "draft",
                "writable": true,
                "final": false
            },
            {
                "name": "approved",
                "writable": true,
                "final": false
            },
            {
                "name": "release",
                "writable": true,
                "final": true
            }
        ],
        "schema.uri": "http://www.eclipse.org/emf/2002/Ecore",
        "root.eclass.uri": "http://www.eclipse.org/emf/2002/Ecore#//EObject",
        "resourceSet.target": "(emf.name=ecore)"
    },
    "ApicurioObjectStorage~apicurio": {
        "base.url": "http://$[env:APICURIO_HOST;default=$[prop:APICURIO_HOST;default=localhost]]:$[env:APICURIO_PORT;default=$[prop:APICURIO_PORT;default=8081]]/apis/registry/v3/",
        "storage.type": "apicurio",
        "registry.target": "(registry=main)"
    }
}
