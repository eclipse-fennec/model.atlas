<?xml version="1.0" encoding="UTF-8"?>
<genmodel:GenModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:genmodel="http://www.eclipse.org/emf/2002/GenModel" modelDirectory="/org.eclipse.fennec.model.atlas.management.git.github.webhook.model/src"
    modelPluginID="org.eclipse.fennec.model.atlas.management.git.github.webhook.model"
    modelName="github-webhook" rootExtendsClass="org.eclipse.emf.ecore.impl.MinimalEObjectImpl$Container"
    importerID="org.eclipse.emf.importer.ecore" complianceLevel="17.0" suppressGenModelAnnotations="false"
    copyrightFields="false" usedGenPackages="../../org.eclipse.fennec.model.atlas.management.git.webhook.model/model/git-webhook.genmodel#//gitwebhook"
    operationReflection="true" importOrganizing="true" oSGiCompatible="true">
  <foreignModel>github-webhook.ecore</foreignModel>
  <genPackages prefix="GithubWebhook" basePackage="org.eclipse.fennec.model.atlas.management.git.github.webhook.model"
      resource="XMI" disposableProviderFactory="true" ecorePackage="github-webhook.ecore#/">
    <genClasses ecoreClass="github-webhook.ecore#//GithubPayload">
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference github-webhook.ecore#//GithubPayload/repository"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference github-webhook.ecore#//GithubPayload/commits"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference github-webhook.ecore#//GithubPayload/headCommit"/>
      <genOperations ecoreOperation="github-webhook.ecore#//GithubPayload/getProvider"
          body="return GitProvider.GITHUB;"/>
      <genOperations ecoreOperation="github-webhook.ecore#//GithubPayload/getCloneUrl"
          body="return getRepository() == null ? null : getRepository().getCloneUrl();"/>
      <genOperations ecoreOperation="github-webhook.ecore#//GithubPayload/getRepositoryFullName"
          body="return getRepository() == null ? null : getRepository().getFullName();"/>
      <genOperations ecoreOperation="github-webhook.ecore#//GithubPayload/getAddedPaths"
          body="java.util.LinkedHashSet&lt;String> paths = new java.util.LinkedHashSet&lt;>();&#xA;for(Commit c : getCommits()) {&#xA;&#x9;paths.addAll(c.getAdded());&#xA;}&#xA;if(getHeadCommit() != null) {&#xA;&#x9;paths.addAll(getHeadCommit().getAdded());&#xA;}&#xA;return new org.eclipse.emf.common.util.BasicEList&lt;>(paths);"/>
      <genOperations ecoreOperation="github-webhook.ecore#//GithubPayload/getModifiedPaths"
          body="java.util.LinkedHashSet&lt;String> paths = new java.util.LinkedHashSet&lt;>();&#xA;for(Commit c : getCommits()) {&#xA;&#x9;paths.addAll(c.getModified());&#xA;}&#xA;if(getHeadCommit() != null) {&#xA;&#x9;paths.addAll(getHeadCommit().getModified());&#xA;}&#xA;return new org.eclipse.emf.common.util.BasicEList&lt;>(paths);"/>
      <genOperations ecoreOperation="github-webhook.ecore#//GithubPayload/getRemovedPaths"
          body="java.util.LinkedHashSet&lt;String> paths = new java.util.LinkedHashSet&lt;>();&#xA;for(Commit c : getCommits()) {&#xA;&#x9;paths.addAll(c.getRemoved());&#xA;}&#xA;if(getHeadCommit() != null) {&#xA;&#x9;paths.addAll(getHeadCommit().getRemoved());&#xA;}&#xA;return new org.eclipse.emf.common.util.BasicEList&lt;>(paths);"/>
    </genClasses>
    <genClasses ecoreClass="github-webhook.ecore#//Repository">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute github-webhook.ecore#//Repository/cloneUrl"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute github-webhook.ecore#//Repository/fullName"/>
    </genClasses>
  </genPackages>
</genmodel:GenModel>
