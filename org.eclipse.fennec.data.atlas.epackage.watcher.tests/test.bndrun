-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.data.atlas.epackage.watcher.tests',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.epackage.watcher',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.osgi.test.junit5.cm'

-runbundles.test: \
	org.eclipse.fennec.data.atlas.epackage.watcher.tests;version=snapshot

-runfw: org.apache.felix.framework

-runee: JavaSE-21

-runbundles: \
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
