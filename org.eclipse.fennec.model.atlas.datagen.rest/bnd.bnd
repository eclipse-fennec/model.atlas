-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	org.eclipse.fennec.codec.rest;version=latest,\
	org.eclipse.fennec.codec.api;version=latest,\
	org.eclipse.fennec.model.atlas.datagen;version=snapshot,\
	org.eclipse.fennec.model.atlas.datagen.model;version=snapshot,\
	org.eclipse.fennec.model.atlas.scope.api;version=snapshot,\
	org.eclipse.fennec.model.atlas.readable.scope.collector;version=snapshot

-library: enableJakartaREST,\
	enableEMF

Private-Package: org.eclipse.fennec.model.atlas.datagen.rest
