	org.apache.felix.http.servlet-api;version='[3.0.0,3.0.1)',\
	org.apache.felix.scr;version='[2.2.14,2.2.15)',\
	org.eclipse.daanse.tooling.testcontainers.core;version='[0.0.1,0.0.2)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
