-library: enableOSGi-Test

# Remote-client runtime (rest.client.osgi + Jakarta RS client + EMF/ConfigAdmin) merged
# with the validation stack (validation + COCL + collector + OCL engine + DataGen model).
# Deliberately NO server bundles (workflow/management/rest.application): the scope service
# comes from the remote P5-4 publication, the Atlas itself runs in the container.
-runrequires: \
	bnd.identity;id='org.eclipse.fennec.model.atlas.validation.client.tests',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.client.osgi',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component',\
	bnd.identity;id='org.eclipse.osgitech.rest',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.validation',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.validation.model',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.readonlyscope.collector',\
	bnd.identity;id='org.eclipse.fennec.m2x.ocl.engine',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.datagen.example.model'

-runbundles.test: \
	org.eclipse.fennec.model.atlas.validation.client.tests;version=snapshot

-runfw: org.apache.felix.framework

-runee: JavaSE-21
-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)',\
	com.fasterxml.jackson.core.jackson-core;version='[2.19.2,2.19.3)',\
	com.fasterxml.jackson.core.jackson-databind;version='[2.19.2,2.19.3)',\
	com.sun.jna;version='[5.18.1,5.18.2)',\
	jakarta.activation-api;version='[2.1.3,2.1.4)',\
	jakarta.annotation-api;version='[2.1.1,2.1.2)',\
	jakarta.inject.jakarta.inject-api;version='[2.0.1,2.0.2)',\
	jakarta.validation.jakarta.validation-api;version='[3.0.2,3.0.3)',\
	jakarta.ws.rs-api;version='[3.1.0,3.1.1)',\
	jakarta.xml.bind-api;version='[4.0.2,4.0.3)',\
	javassist;version='[3.29.2,3.29.3)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	org.antlr.antlr4-runtime;version='[4.13.2,4.13.3)',\
