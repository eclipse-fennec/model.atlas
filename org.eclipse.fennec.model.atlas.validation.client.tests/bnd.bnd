Bundle-Name: Model Atlas Validation — remote-client acceptance test
Bundle-Description: P5-5 — proves the validation service runs unchanged against a remote \
 Atlas backend exposed by rest.client.osgi (the P5-4 per-scope ReadOnlyScopeService \
 publication), bound through the ReadOnlyScopeCollector exactly like the in-process \
 ScopeService. Live jena image via Testcontainers.

Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}

-library: \
	enableOSGi-Test,\
	enableEMF

# Compile-time deps: the OSGi-test ConfigAdmin extension (drives the rest.client.osgi
# factory), the validation + COCL + DataGen model API used by the scenario, the scope.api
# ReadOnlyScopeService waited on, and the OSGified Testcontainers (daanse). EMF +
# emf.osgi (ResourceSetFactory) come via -library enableEMF.
-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.osgi.test.common;version=latest,\
	org.osgi.test.junit5;version=latest,\
	org.osgi.test.junit5.cm;version=latest,\
	org.eclipse.fennec.model.atlas.scope.api;version=snapshot,\
	org.eclipse.fennec.model.atlas.validation;version=snapshot,\
	org.eclipse.fennec.model.atlas.validation.model;version=snapshot,\
	org.eclipse.fennec.model.atlas.datagen.example.model;version=snapshot,\
	org.eclipse.daanse.tooling.testcontainers.core;version=latest

Private-Package: org.eclipse.fennec.model.atlas.validation.client.tests

Bundle-Version: 1.0.0.SNAPSHOT
