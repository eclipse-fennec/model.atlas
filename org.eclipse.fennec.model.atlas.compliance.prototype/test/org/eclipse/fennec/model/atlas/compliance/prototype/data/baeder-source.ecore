  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value="Betriebsdaten der Stadtwerke DIMCity Bäder GmbH, wie sie das Kassensystem (Postgres, Schema baeder) und die App (MongoDB, baeder-app) liefern. Synthetisch, keine realen Personen."/>
  </eAnnotations>
