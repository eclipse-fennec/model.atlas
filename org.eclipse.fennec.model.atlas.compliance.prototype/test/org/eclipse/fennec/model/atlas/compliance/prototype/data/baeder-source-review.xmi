        <detectedBy>CONTAINMENT_CONTEXT</detectedBy>
        <evidence contextId="gdpr" corpusId="02016R0679-20160504-DE" citationId="Rec.30" quote="Nat&#xfc;rlichen Personen werden unter Umst&#xe4;nden Online-Kennungen wie IP-Adressen und Cookie-Kennungen, die sein Ger&#xe4;t oder Software-Anwendungen und -Tools oder Protokolle liefern, oder sonstige Kennungen wie Funkfrequenzkennzeichnungen zugeordnet. Dies kann Spuren hinterlassen, die insbesondere in Kombination mit eindeutigen Kennungen und anderen beim Server eingehenden Informationen dazu benutzt werden k&#xf6;nnen, um Profile der nat&#xfc;rlichen Personen zu erstellen und sie zu identifizieren." verbatim="true" relevance="Ger&#xe4;te- und Plattformdaten sind Ger&#xe4;tekennungen nach Erw&#xe4;gungsgrund 30, die im Verbund mit der Kartennummer zur Profilbildung dienen k&#xf6;nnen." sourceRef="rct_30"/>
      </findings>
    </featureEvaluations>
