    <featureEvaluations id="KarteninhaberBesuch.kartenNr" name="kartenNr" uriFragment="//KarteninhaberBesuch/kartenNr" typeName="EString" relevanceLevel="HIGH">
      <findings id="F-KB-003" origin="AI_AGENT" relevanceLevel="HIGH" confidence="HIGH" rationale="Die Kartennummer ist ein dauerhafter, dem Karteninhaber fest zugeordneter Identifikator. Sie taucht ebenfalls in SaunaBesuch, Checkin und Feedback auf und ermoeglicht die klassen&#xfc;bergreifende Verkn&#xfc;pfung aller Datens&#xe4;tze zu einem Personenprofil.">
        <categories contextId="gdpr" contextVersion="20160504" taxonomyId="data-categories" categoryId="DIRECT_IDENTIFIER"/>
        <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.6(1)"/>
