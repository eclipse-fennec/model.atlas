  <evaluations xsi:type="report:ClassifierEvaluation" id="AuslastungFenster" name="AuslastungFenster" uriFragment="//AuslastungFenster">
    <findings id="F-AF-CLASS-001" origin="AI_AGENT" relevanceLevel="LOW" confidence="MEDIUM" rationale="Die Klasse aggregiert Besucherzahlen in 15-Minuten-Fenstern und unterdr&#xfc;ckt Gruppen unter f&#xfc;nf Personen. Diese k-Anonymit&#xe4;t reduziert das Identifizierungsrisiko erheblich. Der Anonymisierungseffekt h&#xe4;ngt jedoch davon ab, dass die Unterdr&#xfc;ckung zuverl&#xe4;ssig und vollst&#xe4;ndig durchgesetzt wird; eine Klasse mit 'unterdrueckt = false' und 'anzahl = 1' w&#xe4;re dennoch nicht anonym.">
      <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.25(1)"/>
      <detectedBy>DOCUMENTATION_ANNOTATION</detectedBy>
      <signalValues>Aggregiert, Gruppen unter f&#xfc;nf sind unterdr&#xfc;ckt (anzahl leer, unterdrueckt = true).</signalValues>
      <evidence contextId="gdpr" corpusId="02016R0679-20160504-DE" citationId="Rec.26" quote="Die Grunds&#xe4;tze des Datenschutzes sollten daher nicht f&#xfc;r anonyme Informationen gelten, d.h. f&#xfc;r Informationen, die sich nicht auf eine identifizierte oder identifizierbare nat&#xfc;rliche Person beziehen, oder personenbezogene Daten, die in einer Weise anonymisiert worden sind, dass die betroffene Person nicht oder nicht mehr identifiziert werden kann." verbatim="true" relevance="Aggregierte Z&#xe4;hldaten ohne Einzelpersonenbezug k&#xf6;nnen anonym im Sinne von Erw&#xe4;gungsgrund 26 sein, wenn die Unterdr&#xfc;ckung kleiner Gruppen vollst&#xe4;ndig durchgesetzt wird." sourceRef="rct_26"/>
    </findings>
    <featureEvaluations id="AuslastungFenster.id" name="id" uriFragment="//AuslastungFenster/id" typeName="EString"/>
    <featureEvaluations id="AuslastungFenster.beginn" name="beginn" uriFragment="//AuslastungFenster/beginn" typeName="EDate"/>
    <featureEvaluations id="AuslastungFenster.ende" name="ende" uriFragment="//AuslastungFenster/ende" typeName="EDate"/>
