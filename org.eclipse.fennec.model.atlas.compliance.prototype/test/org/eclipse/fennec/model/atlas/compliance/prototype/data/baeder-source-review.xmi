  <evaluations xsi:type="report:ClassifierEvaluation" name="Feedback" uriFragment="//Feedback">
    <featureEvaluations id="Feedback.id" name="id" uriFragment="//Feedback/id" typeName="EString"/>
    <featureEvaluations id="Feedback.zeitpunkt" name="zeitpunkt" uriFragment="//Feedback/zeitpunkt" typeName="EDate" relevanceLevel="LOW">
      <findings id="F-FB-001" origin="AI_AGENT" relevanceLevel="LOW" confidence="HIGH" rationale="Der Bewertungszeitpunkt ist dann personenbezogen, wenn email oder kartenNr im selben Datensatz vorliegen.">
        <categories contextId="gdpr" contextVersion="20160504" taxonomyId="data-categories" categoryId="PERSONAL_DATA"/>
        <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.5(1)(c)"/>
        <detectedBy>FEATURE_NAME</detectedBy>
        <detectedBy>FEATURE_TYPE</detectedBy>
        <detectedBy>OWNING_CLASSIFIER_NAME</detectedBy>
        <evidence contextId="gdpr" corpusId="02016R0679-20160504-DE" citationId="Art.4(1)" quote="&#x201e;personenbezogene Daten&#x201c; alle Informationen, die sich auf eine identifizierte oder identifizierbare nat&#xfc;rliche Person (im Folgenden &#x201e;betroffene Person&#x201c;) beziehen;" relevance="Wenn Feedback mit einer Person verkn&#xfc;pft ist, ist auch der Zeitpunkt eine auf sie bezogene Information." sourceRef="art_4/item[1]"/>
      </findings>
    </featureEvaluations>
    <featureEvaluations id="Feedback.bereich" name="bereich" uriFragment="//Feedback/bereich" typeName="EString"/>
    <featureEvaluations id="Feedback.sterne" name="sterne" uriFragment="//Feedback/sterne" typeName="EInt"/>
    <featureEvaluations id="Feedback.text" name="text" uriFragment="//Feedback/text" typeName="EString" relevanceLevel="HIGH">
      <findings id="F-FB-002" origin="AI_AGENT" relevanceLevel="HIGH" confidence="HIGH" rationale="Das Freitextfeld enth&#xe4;lt nach Dokumentation in rund einem F&#xfc;nftel der F&#xe4;lle Namen, Telefonnummern oder E-Mail-Adressen. Das Metamodell modelliert dieses Risiko mit dem Flag 'enthaeltPersonenbezug', aber das Feld selbst kann jederzeit personenbezogene Daten enthalten. Freitextfelder mit bekanntem Anteil personenbezogener Inhalte sind grunds&#xe4;tzlich als personenbezogen zu behandeln." recommendation="Freitextinhalte sollten vor Weiterverarbeitung und Speicherung automatisiert auf Personenbezug gepr&#xfc;ft und ggf. maskiert werden. Das Flag 'enthaeltPersonenbezug' allein reicht nicht aus, wenn der Rohtext weiter gespeichert wird.">
        <categories contextId="gdpr" contextVersion="20160504" taxonomyId="data-categories" categoryId="DIRECT_IDENTIFIER"/>
        <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.6(1)"/>
        <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.5(1)(c)"/>
        <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.25(1)"/>
        <detectedBy>FEATURE_NAME</detectedBy>
        <detectedBy>DOCUMENTATION_ANNOTATION</detectedBy>
        <signalValues>Rund ein F&#xfc;nftel der Texte nennt Namen, Telefonnummern oder Mailadressen; das Flag enthaeltPersonenbezug ist die Ground Truth f&#xfc;r den DSGVO-Check.</signalValues>
        <evidence contextId="gdpr" corpusId="02016R0679-20160504-DE" citationId="Art.4(1)" quote="&#x201e;personenbezogene Daten&#x201c; alle Informationen, die sich auf eine identifizierte oder identifizierbare nat&#xfc;rliche Person (im Folgenden &#x201e;betroffene Person&#x201c;) beziehen; als identifizierbar wird eine nat&#xfc;rliche Person angesehen, die direkt oder indirekt, insbesondere mittels Zuordnung zu einer Kennung wie einem Namen, zu einer Kennnummer, zu Standortdaten, zu einer Online-Kennung oder zu einem oder mehreren besonderen Merkmalen, die Ausdruck der physischen, physiologischen, genetischen, psychischen, wirtschaftlichen, kulturellen oder sozialen Identit&#xe4;t dieser nat&#xfc;rlichen Person sind, identifiziert werden kann;" relevance="Namen und Kontaktdaten, die in Freitexten erscheinen, sind personenbezogene Daten nach Art. 4 Nr. 1." sourceRef="art_4/item[1]"/>
        <evidence contextId="gdpr" corpusId="02016R0679-20160504-DE" citationId="Art.25(1)" quote="Unter Ber&#xfc;cksichtigung des Stands der Technik, der Implementierungskosten und der Art, des Umfangs, der Umst&#xe4;nde und der Zwecke der Verarbeitung sowie der unterschiedlichen Eintrittswahrscheinlichkeit und Schwere der mit der Verarbeitung verbundenen Risiken f&#xfc;r die Rechte und Freiheiten nat&#xfc;rlicher Personen trifft der Verantwortliche sowohl zum Zeitpunkt der Festlegung der Mittel f&#xfc;r die Verarbeitung als auch zum Zeitpunkt der eigentlichen Verarbeitung geeignete technische und organisatorische Ma&#xdf;nahmen &#x2014; wie z.&#xa0;B. Pseudonymisierung &#x2014;, die daf&#xfc;r ausgelegt sind, die Datenschutzgrunds&#xe4;tze wie etwa Datenminimierung wirksam umzusetzen und die notwendigen Garantien in die Verarbeitung aufzunehmen, um den Anforderungen dieser Verordnung zu gen&#xfc;gen und die Rechte der betroffenen Personen zu sch&#xfc;tzen." relevance="Der bekannte Anteil personenbezogener Inhalte im Freitextfeld verlangt technische und organisatorische Ma&#xdf;nahmen (Privacy by Design), z.B. automatisierte Erkennung und Schw&#xe4;rzung vor Weiterverarbeitung." sourceRef="art_25/parag[1]"/>
      </findings>
    </featureEvaluations>
    <featureEvaluations id="Feedback.enthaeltPersonenbezug" name="enthaeltPersonenbezug" uriFragment="//Feedback/enthaeltPersonenbezug" typeName="EBoolean" relevanceLevel="MEDIUM">
      <findings id="F-FB-003" origin="AI_AGENT" relevanceLevel="MEDIUM" confidence="HIGH" rationale="Das Flag 'enthaeltPersonenbezug' dokumentiert, dass personenbezogene Inhalte im Freitextfeld erkannt wurden. Es ist zwar positiv, dass diese Klassifikation modelliert ist, aber das Flag ersetzt nicht die Pflicht zur Datenminimierung: Auch markierte Datens&#xe4;tze m&#xfc;ssen einer Rechtsgrundlage und einem Zweck entsprechen.">
        <categories contextId="gdpr" contextVersion="20160504" taxonomyId="data-categories" categoryId="PERSONAL_DATA"/>
        <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.5(1)(a)"/>
        <detectedBy>FEATURE_NAME</detectedBy>
        <detectedBy>DOCUMENTATION_ANNOTATION</detectedBy>
        <signalValues>das Flag enthaeltPersonenbezug ist die Ground Truth f&#xfc;r den DSGVO-Check</signalValues>
        <evidence contextId="gdpr" corpusId="02016R0679-20160504-DE" citationId="Art.5(1)(a)" quote="auf rechtm&#xe4;&#xdf;ige Weise, nach Treu und Glauben und in einer f&#xfc;r die betroffene Person nachvollziehbaren Weise verarbeitet werden (&#x201e;Rechtm&#xe4;&#xdf;igkeit, Verarbeitung nach Treu und Glauben, Transparenz&#x201c;);" relevance="Ein Flag allein begr&#xfc;ndet keine Rechtsgrundlage; die Verarbeitung des Freitexts einschlie&#xdf;lich personenbezogener Inhalte muss rechtm&#xe4;&#xdf;ig sein." sourceRef="art_5/parag[1]/item[1]"/>
      </findings>
    </featureEvaluations>
    <featureEvaluations id="Feedback.email" name="email" uriFragment="//Feedback/email" typeName="EString" relevanceLevel="HIGH">
      <findings id="F-FB-004" origin="AI_AGENT" relevanceLevel="HIGH" confidence="HIGH" rationale="Eine E-Mail-Adresse in einem Feedback-Datensatz ist ein direkter Identifikator, auch wenn das Feedback sonst anonym eingegangen ist. Die E-Mail-Adresse macht den gesamten Datensatz eindeutig einer Person zuordenbar.">
        <categories contextId="gdpr" contextVersion="20160504" taxonomyId="data-categories" categoryId="DIRECT_IDENTIFIER"/>
        <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.6(1)"/>
        <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.5(1)(c)"/>
        <detectedBy>FEATURE_NAME</detectedBy>
        <evidence contextId="gdpr" corpusId="02016R0679-20160504-DE" citationId="Art.4(1)" quote="&#x201e;personenbezogene Daten&#x201c; alle Informationen, die sich auf eine identifizierte oder identifizierbare nat&#xfc;rliche Person (im Folgenden &#x201e;betroffene Person&#x201c;) beziehen;" relevance="Die E-Mail-Adresse im Feedback macht den Datensatz eindeutig personenbezogen nach Art. 4 Nr. 1." sourceRef="art_4/item[1]"/>
      </findings>
    </featureEvaluations>
    <featureEvaluations id="Feedback.kartenNr" name="kartenNr" uriFragment="//Feedback/kartenNr" typeName="EString" relevanceLevel="HIGH">
      <findings id="F-FB-005" origin="AI_AGENT" relevanceLevel="HIGH" confidence="HIGH" rationale="Die Kartennummer im Feedback-Datensatz verkn&#xfc;pft die Bewertung eindeutig mit dem Karteninhaber und macht den Datensatz personenbezogen. Sie erm&#xf6;glicht die Verquickung von Feedback-Inhalt und Besuchshistorie.">
        <categories contextId="gdpr" contextVersion="20160504" taxonomyId="data-categories" categoryId="DIRECT_IDENTIFIER"/>
        <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.6(1)"/>
        <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.5(1)(c)"/>
        <detectedBy>FEATURE_NAME</detectedBy>
        <evidence contextId="gdpr" corpusId="02016R0679-20160504-DE" citationId="Art.4(1)" quote="&#x201e;personenbezogene Daten&#x201c; alle Informationen, die sich auf eine identifizierte oder identifizierbare nat&#xfc;rliche Person (im Folgenden &#x201e;betroffene Person&#x201c;) beziehen;" relevance="Die kartenNr als Kennnummer im Feedback-Datensatz macht ihn eindeutig einer nat&#xfc;rlichen Person zuordenbar." sourceRef="art_4/item[1]"/>
      </findings>
    </featureEvaluations>
  </evaluations>
  <combinations id="CF-001" origin="AI_AGENT" relevanceLevel="HIGH" confidence="HIGH" rationale="Die Kombination aus Kartennummer (Pseudonym), Geburtsjahr und PLZ bildet einen Quasi-Identifikatoren-Satz, der laut Modellannotation explizit als re-identifizierbar eingestuft wird. Obwohl kein direkter Name vorliegt, erm&#xf6;glicht die Kartennummer die R&#xfc;ckf&#xfc;hrung auf KarteninhaberBesuch, und Geburtsjahr + PLZ verkleinern die Anonymit&#xe4;tsmenge erheblich. Das klassische Latanya-Sweeney-Ergebnis zeigt, dass PLZ + Geschlecht + Geburtsdatum rund 87 % der US-Bev&#xf6;lkerung eindeutig identifizieren; PLZ + Geburtsjahr reicht f&#xfc;r einen erheblichen Anteil." recommendation="Das Geburtsjahr k&#xf6;nnte auf ein Jahrzehnt vergr&#xf6;bert oder die PLZ auf eine 2-stellige Kennung reduziert werden, um den Quasi-Identifikator-Satz aufzubrechen." features="#SaunaBesuch.kartenNr #SaunaBesuch.geburtsjahr #SaunaBesuch.plz">
    <categories contextId="gdpr" contextVersion="20160504" taxonomyId="combination-kinds" categoryId="QUASI_IDENTIFIER_SET"/>
    <categories contextId="gdpr" contextVersion="20160504" taxonomyId="data-categories" categoryId="PSEUDONYMISED"/>
    <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.5(1)(c)"/>
    <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.25(1)"/>
    <detectedBy>FEATURE_COMBINATION</detectedBy>
    <detectedBy>DOCUMENTATION_ANNOTATION</detectedBy>
    <signalValues>Sieht anonym aus, ist es nicht: Pseudonym plus Quasi-Identifikatoren.</signalValues>
    <evidence contextId="gdpr" corpusId="02016R0679-20160504-DE" citationId="Rec.26" quote="Um festzustellen, ob eine nat&#xfc;rliche Person identifizierbar ist, sollten alle Mittel ber&#xfc;cksichtigt werden, die von dem Verantwortlichen oder einer anderen Person nach allgemeinem Ermessen wahrscheinlich genutzt werden, um die nat&#xfc;rliche Person direkt oder indirekt zu identifizieren, wie beispielsweise das Aussondern. Bei der Feststellung, ob Mittel nach allgemeinem Ermessen wahrscheinlich zur Identifizierung der nat&#xfc;rlichen Person genutzt werden, sollten alle objektiven Faktoren, wie die Kosten der Identifizierung und der daf&#xfc;r erforderliche Zeitaufwand, herangezogen werden, wobei die zum Zeitpunkt der Verarbeitung verf&#xfc;gbare Technologie und technologische Entwicklungen zu ber&#xfc;cksichtigen sind." verbatim="true" relevance="Der Quasi-Identifikatoren-Satz PLZ + Geburtsjahr + Kartennummer erm&#xf6;glicht das 'Aussondern' einer Person nach Erw&#xe4;gungsgrund 26." sourceRef="rct_26"/>
  </combinations>
  <combinations id="CF-002" origin="AI_AGENT" relevanceLevel="HIGH" confidence="HIGH" rationale="Die Kombination aus Kartennummer, Besuchsdatum, Bereich sowie genauen Einlass- und Auslasszeitpunkten erlaubt die automatisierte Erstellung eines detaillierten Nutzungsprofils: Wie oft kommt eine Person, wann, welche Bereiche nutzt sie, wie lange bleibt sie. Dies ist Profiling im Sinne von Art. 4 Nr. 4 DSGVO, da Verhaltensaspekte und Gewohnheiten einer identifizierten Person bewertet werden k&#xf6;nnen." recommendation="Pr&#xfc;fen, ob alle Zeitstempel und Besuchsdaten auf Individuumsebene f&#xfc;r den Verarbeitungszweck erforderlich sind. Sofern keine explizite Rechtsgrundlage f&#xfc;r Profiling vorliegt, sollte eine Datenschutz-Folgenabsch&#xe4;tzung durchgef&#xfc;hrt werden." features="#KarteninhaberBesuch.kartenNr #KarteninhaberBesuch.einlass #KarteninhaberBesuch.auslass #KarteninhaberBesuch.bereich #KarteninhaberBesuch.datum">
    <categories contextId="gdpr" contextVersion="20160504" taxonomyId="combination-kinds" categoryId="PROFILING"/>
    <categories contextId="gdpr" contextVersion="20160504" taxonomyId="data-categories" categoryId="PERSONAL_DATA"/>
    <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.6(1)"/>
    <requirements contextId="gdpr" contextVersion="20160504" requirementId="Art.35(1)"/>
    <detectedBy>FEATURE_COMBINATION</detectedBy>
    <detectedBy>OWNING_CLASSIFIER_NAME</detectedBy>
    <evidence contextId="gdpr" corpusId="02016R0679-20160504-DE" citationId="Art.4(4)" quote="&#x201e;Profiling&#x201c; jede Art der automatisierten Verarbeitung personenbezogener Daten, die darin besteht, dass diese personenbezogenen Daten verwendet werden, um bestimmte pers&#xf6;nliche Aspekte, die sich auf eine nat&#xfc;rliche Person beziehen, zu bewerten, insbesondere um Aspekte bez&#xfc;glich Arbeitsleistung, wirtschaftliche Lage, Gesundheit, pers&#xf6;nliche Vorlieben, Interessen, Zuverl&#xe4;ssigkeit, Verhalten, Aufenthaltsort oder Ortswechsel dieser nat&#xfc;rlichen Person zu analysieren oder vorherzusagen;" relevance="Besuchsdaten (Datum, Bereich, Einlass, Auslass) einer identifizierten Person erm&#xf6;glichen die Analyse von Verhalten, Gewohnheiten und Aufenthaltsort im Sinne des Profiling-Tatbestands." sourceRef="art_4/item[4]"/>
    <evidence contextId="gdpr" corpusId="02016R0679-20160504-DE" citationId="Art.35(1)" quote="Hat eine Form der Verarbeitung, insbesondere bei Verwendung neuer Technologien, aufgrund der Art, des Umfangs, der Umst&#xe4;nde und der Zwecke der Verarbeitung voraussichtlich ein hohes Risiko f&#xfc;r die Rechte und Freiheiten nat&#xfc;rlicher Personen zur Folge, so f&#xfc;hrt der Verantwortliche vorab eine Absch&#xe4;tzung der Folgen der vorgesehenen Verarbeitungsvorg&#xe4;nge f&#xfc;r den Schutz personenbezogener Daten durch." verbatim="true" relevance="Systematisches Profiling von Besuchsgewohnheiten kann ein hohes Risiko f&#xfc;r Betroffene darstellen und eine DSFA erforderlich machen." sourceRef="art_35/parag[1]"/>
  </combinations>
  <combinations id="CF-003" origin="AI_AGENT" relevanceLevel="HIGH" confidence="HIGH" rationale="Das Feld 'kartenNr' taucht als Schl&#xfc;ssel in vier verschiedenen Klassen auf: KarteninhaberBesuch (Stammdaten), SaunaBesuch (pseudonymisierte Besuchsdaten), Checkin (App-Ereignisse) und Feedback (Bewertungen). Dies erm&#xf6;glicht eine vollst&#xe4;ndige verkn&#xfc;pfte Sicht auf eine Person: ihre Identit&#xe4;t, ihre Saunagewohnheiten, ihre App-Nutzung inkl. Standortdaten und ihre ge&#xe4;u&#xdf;erten Meinungen. Diese systemweite Verkn&#xfc;pfung &#xfc;ber eine einzige Kennung ist ein Profiling-Risiko h&#xf6;chster Stufe." recommendation="Pr&#xfc;fen, ob die klassen&#xfc;bergreifende Verkn&#xfc;pfung &#xfc;ber kartenNr f&#xfc;r alle Verarbeitungszwecke erforderlich ist. Zugriffskontrollen sollten sicherstellen, dass nicht alle Klassen gemeinsam abgefragt werden k&#xf6;nnen, wenn der Zweck dies nicht erfordert." features="#KarteninhaberBesuch.kartenNr #SaunaBesuch.kartenNr #Checkin.kartenNr #Feedback.kartenNr">
