Bundle-Name: Model Atlas REST Client — OSGi front-end
Bundle-Description: OSGi DS front-end for the Model Atlas client. P3-1: a ConfigAdmin \
 factory component (PID org.eclipse.fennec.model.atlas.rest.client) that maps a \
 configuration onto the shared ClientConfiguration and builds one plain-Java \
 ModelAtlasClient per Atlas instance. EPackage publishing, resolution modes, drift \
 substitution and ResourceSet integration are added by later Phase-3 tickets.

-library: enableEMF
-workingset: atlas

-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.resource;version=latest,\
	org.eclipse.fennec.model.atlas.rest.client.api;version=snapshot,\
	org.eclipse.fennec.model.atlas.rest.client.impl;version=snapshot,\
	jakarta.ws.rs-api;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.eclipse.fennec.model.atlas.scope.api;version=snapshot,\
	org.eclipse.fennec.emf.osgi.component.minimal;version=latest,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest

-testpath: \
	junit-jupiter-api,\
	org.eclipse.fennec.model.atlas.rest.client.api

# The metadata layer is optional at runtime (#277): a deployment without it resolves and behaves
# exactly as before, the bridge simply registers nothing.
Import-Package: \
	org.eclipse.fennec.emf.osgi.metadata;resolution:=optional,\
	org.eclipse.fennec.emf.osgi.model.metadata;resolution:=optional,\
	*
