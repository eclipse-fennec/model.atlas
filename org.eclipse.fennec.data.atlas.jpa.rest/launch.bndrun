	bnd.identity;id='org.eclipse.fennec.data.atlas.jpa.config.local',\
	bnd.identity;id='com.h2database',\
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.h2',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.jpa.datasource',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.jpa.mapping.watcher',\
