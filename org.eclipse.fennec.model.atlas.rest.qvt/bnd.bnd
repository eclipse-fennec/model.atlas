Bundle-Name: Model Atlas - QVT REST Support
Bundle-Description: Serves QVT-O sources over REST (issue #239): a text/x-qvto \
 MessageBodyReader/Writer that carries .qvto text as SourceUnit documents through the generic \
 registry endpoints, so an editor uploads plain transformation text and reads it back unchanged.

-library: enableEMF

-buildpath: \
	jakarta.ws.rs-api;version='2.1.6',\
	org.osgi.service.component.annotations,\
	org.osgi.service.jakartars,\
	org.osgi.service.component,\
	org.eclipse.fennec.m2x.unit;version=latest,\
	org.eclipse.fennec.model.atlas.qvt;version=snapshot,\
	org.eclipse.fennec.model.atlas.rest.common;version=snapshot
