-library: enableOSGi-Test

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'

-runee: JavaSE-21

-runproperties: \
	org.osgi.service.http.port=-1,\
	geckotest=true,\
	gecko.log.level=INFO,\
	${if;${is;${driver};gradle};gosh.args=--nointeractive}

-runtrace: false

-runvm: \
	-ea

# Deliberately NOT '-resolve.effective: active'. With service requirements in
# effect, resolving this runtime would also have to satisfy every mandatory
# @Reference of every included bundle — MediaTypesHealthCheck's SupportedMediatype,
# the workflow bundle's EObjectStorageService, and so on — which drags in the whole
# storage stack and makes the resolve depend on unrelated projects being built
# first. These tests exercise ScopesHealthCheck, which needs no service provider;
# the components whose references stay unsatisfied simply do not activate.
-runrequires: \
	bnd.identity;id='org.eclipse.fennec.model.atlas.healthcheck',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.healthcheck.tests',\
	bnd.identity;id='org.apache.felix.scr',\
	bnd.identity;id='org.apache.felix.gogo.runtime',\
	bnd.identity;id='org.apache.felix.gogo.shell'

# Ensure clean environment
-runkeep: false

-runblacklist: \
	bnd.identity;id='org.eclipse.uml2.uml';version='[0.0.0,5.6.0)',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.management.apicurio'
